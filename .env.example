# ==============================================================================
# Observability Flag (controls OpenTelemetry tracing, metrics, and OTLP logging)
# Set to 'false' or '0' to disable observability across all microservices
# ==============================================================================
ENABLE_OBSERVABILITY=true

# OpenTelemetry Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=postgres

# Microservice Endpoints
ORDER_GRPC_URL=127.0.0.1:5001
PAYMENTS_GRPC_URL=127.0.0.1:5000
LOGIN_GRPC_URL=127.0.0.1:5002

# Ports
API_GATEWAY_PORT=3000
LOGIN_SERVICE_PORT=3003
JWT_SECRET=service-broker-jwt-secret-key-12345
